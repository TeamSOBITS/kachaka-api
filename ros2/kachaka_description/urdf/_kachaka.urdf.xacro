<?xml version="1.0"?>
<robot name="kachaka_robot" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="kachaka_robot" params="parent *origin">
    <!-- base_footprint -->
    <joint name="base_footprint_joint"
          type="fixed">
      <parent link="${parent}" />
      <child link="base_link" />
      <xacro:insert_block name="origin" />
    </joint>
    <link name="base_link">
      <inertial>
        <mass value="10.0" />
        <origin xyz="0.0435 0.0 0.0475"
                rpy="0 0 0" />
        <inertia ixx="${1/12*10*(0.095**2+0.240**2)}" ixy="0" ixz="0"
                iyy="${1/12*10*(0.095**2+0.387**2)}" iyz="0"
                izz="${1/12*10*(0.387**2+0.240**2)}" />
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="-0.150 -0.120 0.0"/>
        <geometry>
          <mesh filename="file://$(find kachaka_description)/meshes/kachaka/body.stl"/>
        </geometry>
        <material name="body" />
      </visual>
      <!-- Static dock connector split from body.stl; mesh is in base_link coords -->
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find kachaka_description)/meshes/kachaka/docking.stl"/>
        </geometry>
        <material name="body" />
      </visual>
      <!-- Spans body underside (z=0.0075) to top plate (z=0.095); only wheels and casters touch ground -->
      <collision>
        <origin xyz="0.0435 0.0 ${(0.0075 + 0.095) / 2}"
                rpy="0 0 0" />
        <geometry>
          <box size="0.387 0.240 ${0.095 - 0.0075}" />
        </geometry>
        <material name="body" />
      </collision>
    </link>

    <!-- Wheel(right) -->
    <joint name="base_r_drive_wheel_joint"
          type="continuous">
      <parent link="base_link" />
      <child link="base_r_drive_wheel_link" />
      <origin rpy="0 0 0"
              xyz="0.0 -0.100 0.045" />
      <axis xyz="0 1 0" />
      <limit velocity="10"
            effort="100" />
    </joint>
    <link name="base_r_drive_wheel_link">
      <inertial>
        <mass value="0.2" /> <!-- TODO - Update mass value -->
        <origin xyz="0 0 0"
                rpy="${PI / 2.0} 0 0" />
        <!-- Bug - inertial rotation is not reflected in Rviz2 -->
        <!-- https://github.com/ros2/rviz/pull/1316 -->
        <inertia ixx="${1/12*0.2*(3*0.045**2+0.025**2)}" ixy="0" ixz="0"
                iyy="${1/12*0.2*(3*0.045**2+0.025**2)}" iyz="0"
                izz="${1/2*0.2*(0.045**2)}" />
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find kachaka_description)/meshes/kachaka/right_tire.stl" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="tire" />
      </visual>
      <collision>
        <origin xyz="0 0 0"
                rpy="${PI / 2.0} 0 0" />
        <geometry>
          <cylinder length="0.025"
                    radius="0.045" />
        </geometry>
        <material name="tire" />
      </collision>
    </link>

    <!-- Wheel(left) -->
    <joint name="base_l_drive_wheel_joint"
          type="continuous">
      <parent link="base_link" />
      <child link="base_l_drive_wheel_link" />
      <origin rpy="0 0 0"
              xyz="0.0 0.100 0.045" />
      <axis xyz="0 1 0" />
      <limit velocity="10"
            effort="100" />
    </joint>
    <link name="base_l_drive_wheel_link">
      <inertial>
        <mass value="0.2" />
        <origin xyz="0 0 0"
                rpy="${PI / 2.0} 0 0" />
        <!-- Bug - inertial rotation is not reflected in Rviz2 -->
        <!-- https://github.com/ros2/rviz/pull/1316 -->
        <inertia ixx="${1/12*0.2*(3*0.045**2+0.025**2)}" ixy="0" ixz="0"
                iyy="${1/12*0.2*(3*0.045**2+0.025**2)}" iyz="0"
                izz="${1/2*0.2*(0.045**2)}" />
      </inertial>
      <visual>
        <origin xyz="0 0 0"
                rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find kachaka_description)/meshes/kachaka/left_tire.stl" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="tire" />
      </visual>
      <collision>
        <origin xyz="0 0 0"
                rpy="${PI / 2.0} 0 0" />
        <geometry>
          <cylinder length="0.025"
                    radius="0.045" />
        </geometry>
        <material name="tire" />
      </collision>
    </link>

    <!-- Caster(right) split from body.stl; mesh origin at ball centre, ball rests on z=0 -->
    <joint name="base_r_caster_joint"
          type="fixed">
      <parent link="base_link" />
      <child link="base_r_caster_link" />
      <origin rpy="0 0 0"
              xyz="0.1945 -0.0678 0.0153" />
    </joint>
    <link name="base_r_caster_link">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find kachaka_description)/meshes/kachaka/caster_r.stl"/>
        </geometry>
        <material name="tire" />
      </visual>
      <collision>
        <origin xyz="0 0 0"
                rpy="0 0 0" />
        <geometry>
          <sphere radius="0.0153" />
        </geometry>
      </collision>
    </link>

    <!-- Caster(left) split from body.stl; mesh origin at ball centre, ball rests on z=0 -->
    <joint name="base_l_caster_joint"
          type="fixed">
      <parent link="base_link" />
      <child link="base_l_caster_link" />
      <origin rpy="0 0 0"
              xyz="0.1971 0.0796 0.0153" />
    </joint>
    <link name="base_l_caster_link">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find kachaka_description)/meshes/kachaka/caster_l.stl"/>
        </geometry>
        <material name="tire" />
      </visual>
      <collision>
        <origin xyz="0 0 0"
                rpy="0 0 0" />
        <geometry>
          <sphere radius="0.0153" />
        </geometry>
      </collision>
    </link>

    <!-- 2D LiDAR -->
    <joint name="lidar_joint"
          type="fixed">
      <parent link="base_link" />
      <child link="laser_frame" />
      <origin rpy="0 0 ${PI / 2.0}"
              xyz="0.156 0 0.1049" />
    </joint>
    <!-- LiDAR head split from body.stl so scan-plane hits can be tuned per sim; mesh is in laser_frame coords -->
    <link name="laser_frame">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find kachaka_description)/meshes/kachaka/lidar.stl"/>
        </geometry>
        <material name="body" />
      </visual>
    </link>

    <!-- Camera(front) -->
    <joint name="camera_front_joint"
          type="fixed">
      <parent link="base_link" />
      <child link="camera_front_link" />
      <origin rpy="-${PI / 2.0} 0 -${PI / 2.0}"
              xyz="${0.2196 - 0.01} 0 0.070" />
    </joint>
    <link name="camera_front_link" />

    <!-- Camera(back) -->
    <joint name="camera_back_joint"
          type="fixed">
      <parent link="base_link" />
      <child link="camera_back_link" />
      <origin rpy="-${PI / 2.0} 0 ${PI / 2.0}"
              xyz="${-0.150 + 0.01} 0 0.070" />
    </joint>
    <link name="camera_back_link" />

    <!-- ToF camera -->
    <joint name="tof_joint"
          type="fixed">
      <parent link="base_link" />
      <child link="tof_link" />
      <origin rpy="-${PI / 4.0} 0 -${PI / 2.0}"
              xyz="0.221 0.0 0.0418" />
    </joint>
    <link name="tof_link" />

    <!-- Docking -->
    <joint name="docking_joint"
          type="prismatic">
      <parent link="base_link" />
      <child link="docking_link" />
      <axis xyz="0 0 1.0" />
      <origin rpy="0 0 0"
              xyz="0 0 0" />
      <limit lower="0.0"
            upper="0.012"
            effort="1.0"
            velocity="1.0" />
    </joint>
    <link name="docking_link">
      <inertial>
        <mass value="0.2" /> <!-- TODO - Update mass value -->
        <origin xyz="0 0 ${0.0735 + 0.0395 / 2}"
                rpy="0 0 0" />
        <inertia ixx="${1/12*0.2*(3*0.030**2+0.0395**2)}" ixy="0" ixz="0"
                 iyy="${1/12*0.2*(3*0.030**2+0.0395**2)}" iyz="0"
                 izz="${1/2*0.2*(0.030**2)}" />
      </inertial>
      <!-- solenoid.stl spans z 0..0.0395; lift so its top meets the connector top (z=0.113) -->
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0.0735"/>
        <geometry>
          <mesh filename="file://$(find kachaka_description)/meshes/kachaka/solenoid.stl"
                scale="1.0 1.0 1.0" />
        </geometry>
        <material name="body" />
      </visual>
      <collision>
        <origin xyz="0 0 ${0.0735 + 0.0395 / 2}"
                rpy="0 0 0" />
        <geometry>
          <cylinder length="0.0395"
                    radius="0.030" />
        </geometry>
        <material name="body" />
      </collision>
    </link>

    <!-- IMU -->
    <joint name="imu_joint"
          type="fixed">
      <parent link="base_link" />
      <child link="imu_link" />
      <origin rpy="0 0 0"
              xyz="0.0756 -0.0655 0.05146" />
    </joint>
    <link name="imu_link" />
  </xacro:macro>
</robot>
